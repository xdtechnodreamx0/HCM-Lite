# Copy to .env. Never commit real values.

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=hcm_lite
SESSION_SECRET=replace_with_at_least_32_random_characters
APP_BASE_URL=http://localhost:3000
# Optional. Leave empty to show an honest AI-not-configured state.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_API_KEY=
# Optional real email verification during first Admin setup. Configure both values.
RESEND_API_KEY=
EMAIL_FROM=
