# Copy to .env. Never commit real values.

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=hcm_lite
SESSION_SECRET=replace_with_at_least_32_random_characters
# Public origin used for links in verification/reset emails. Same-origin API
# checks also accept the request's real (forwarded) host, so Vercel aliases do
# not need to be duplicated here.
APP_BASE_URL=http://localhost:3000
# Optional. Leave empty to show an honest AI-not-configured state.
GEMINI_API_KEY=
# Free-tier default. Gemini applies a daily request quota per model; the server
# falls back through gemini-3-flash-preview, gemini-3.5-flash-lite, and
# gemini-3.5-flash when a model is retired, overloaded, or out of quota.
GEMINI_MODEL=gemini-flash-lite-latest
AI_API_KEY=
# Optional real email delivery. Configure one provider:
# 1. SMTP (works with a Gmail app password and can email any recipient):
#    SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#    SMTP_USER=you@gmail.com, SMTP_PASS=your_app_password
# 2. Resend (requires a verified sending domain for arbitrary recipients):
#    RESEND_API_KEY=... and EMAIL_FROM=People.works <team@yourdomain.com>
# Set EMAIL_PROVIDER=resend to force Resend when both are configured.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=
# Local/demo only: enables one-click entry to seeded demo portals. Keep false in
# production; it never grants access to a non-demo company.
DEMO_MODE=false
