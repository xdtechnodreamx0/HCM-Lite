# Copy to .env. Never commit real values.

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=hcm_lite
SESSION_SECRET=replace_with_at_least_32_random_characters
# Public origin used for links in verification/reset emails. Same-origin API
# checks also accept the request's real (forwarded) host, so Vercel aliases do
# not need to be duplicated here.
APP_BASE_URL=http://localhost:3000
# Optional. Leave empty to show an honest AI-not-configured state.
GEMINI_API_KEY=
# Free-tier default. The server also falls back through gemini-2.0-flash and
# gemini-1.5-flash if the configured model is retired for your key.
GEMINI_MODEL=gemini-2.5-flash
AI_API_KEY=
# Optional real email verification during first Admin setup. Configure both values.
RESEND_API_KEY=
EMAIL_FROM=
